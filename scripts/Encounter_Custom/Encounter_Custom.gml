function Encounter_Custom() {
	Encounter_Set(0,-1,battle_enemy /* Or whatever you called your enemy */,-1,"* test?",mus_battle1 /* This defines what music plays during the fight. Change this to whatever you like, or delete it completely */);
	Encounter_Set(1,-1,battle_enemy_dunstbuns /* Or whatever you called your enemy */,-1,"* Dunstbuns floats by.",mus_battle1 /* This defines what music plays during the fight. Change this to whatever you like, or delete it completely */);

}
